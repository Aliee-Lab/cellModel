#!/bin/bash
#BATCH --job-name=state_rpe1
#SBATCH --partition=h200
#SBATCH --qos=h200_prio
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=2
#SBATCH --mem=200G
#SBATCH --time=60:00:00
#SBATCH --output=%x_%j.out
#SBATCH --error=%x_%j.err

set -e
echo "=== Job started: $(date) ==="
echo "Running on node: $(hostname)"
nvidia-smi --query-gpu=name,memory.total,memory.used --format=csv
echo "Using state binary: $(which state)"

DATA_DIR="/mnt/scratche/slow/halab/Hana/Data/Pert/STATE/Replogle_Nadig/"
RUN_DIR="$HOME/state_rpe1_matched_5000"

echo "=== [1/3] Preprocessing started: $(date) ==="
state tx preprocess_train \
    --adata "${DATA_DIR}/replogle.h5ad" \
    --output "${DATA_DIR}/processed_data/replogle_full_trained.h5ad" \
    --num_hvgs 6642
echo "=== [1/3] Preprocessing finished: $(date) ==="

echo "=== [2/3] Training started: $(date) ==="
state tx train \
  data.kwargs.toml_config_path="/mnt/scratche/slow/halab/Hana/gears_matched_full_split.toml" \
  data.kwargs.embed_key=X_hvg \
  data.kwargs.pert_col=gene \
  data.kwargs.cell_type_key=cell_line \
  data.kwargs.control_pert=non-targeting \
  training.max_steps=40000 \
  training.batch_size=8 \
  model=state \
  output_dir="${RUN_DIR}" \
  name="gears_matched_run"
echo "=== [2/3] Training finished: $(date) ==="

echo "=== [3/3] Locating checkpoint ==="
CKPT=$(find "${RUN_DIR}/gears_matched_run" -iname "*.ckpt" | head -n 1)
if [ -z "$CKPT" ]; then
    echo "ERROR: no checkpoint found after training."
    exit 1
fi
echo "Found checkpoint: $CKPT"
state tx predict --output-dir "${RUN_DIR}/gears_matched_run" --checkpoint "$CKPT"
echo "=== JOB COMPLETE: $(date) ==="
